# AERUPT environment — copy to `.env` or export in your shell.
# The agent runs fine with NONE of these set (deterministic + sandbox).

# --- Hybrid LLM (Groq, OpenAI-compatible) ------------------------------
# Generate grounded answers + aviation Q&A over the RAG knowledge base.
# Without a key, AERUPT falls back to deterministic generation.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT_S=8
# AERUPT_LLM=1

# --- RAG embeddings ------------------------------------------------------
# "sentence" -> use a local sentence-transformer encoder; default "tfidf".
# AERUPT_RAG_EMBEDDINGS=tfidf
# AERUPT_RAG_SENTENCE_MODEL=all-MiniLM-L6-v2
# AERUPT_KB_DIR=knowledge
# AERUPT_KB_TOP_K=3

# --- Flight platform -----------------------------------------------------
# mock   (default)  : in-repo sandbox (identical to the evaluated harness)
# amadeus          : real Amadeus Self-Service API (test sandbox by default)
AERUPT_PLATFORM=mock
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_BASE_URL=https://test.api.amadeus.com   # use https://api.amadeus.com for production creds